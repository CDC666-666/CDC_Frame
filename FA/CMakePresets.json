{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {}
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "Debug-imu",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "FRAME_CDC_SCENE": "imu"
            }
        },
        {
            "name": "Debug-can-imu",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "FRAME_CDC_SCENE": "motor_bench_imu"
            }
        },
        {
            "name": "Debug-can-motor",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "FRAME_CDC_SCENE": "motor_bench_motor"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "Debug-imu",
            "configurePreset": "Debug-imu"
        },
        {
            "name": "Debug-can-imu",
            "configurePreset": "Debug-can-imu"
        },
        {
            "name": "Debug-can-motor",
            "configurePreset": "Debug-can-motor"
        }
    ]
}
