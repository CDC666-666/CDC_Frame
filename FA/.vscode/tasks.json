{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "MC02 · 配置 Debug",
            "type": "cmake",
            "command": "configure",
            "preset": "Debug"
        },
        {
            "label": "MC02 · 编译 Debug",
            "type": "cmake",
            "command": "build",
            "preset": "Debug",
            "targets": [
                "MC02"
            ],
            "dependsOn": [
                "MC02 · 配置 Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "MC02 · 编译、烧录并运行（DAPLink）",
            "type": "process",
            "command": "D:/Apps/xpack-openocd-0.12.0-7-win32-x64/xpack-openocd-0.12.0-7/bin/openocd.exe",
            "args": [
                "-s",
                "D:/Apps/xpack-openocd-0.12.0-7-win32-x64/xpack-openocd-0.12.0-7/openocd/scripts",
                "-f",
                "interface/cmsis-dap.cfg",
                "-c",
                "transport select swd",
                "-f",
                "target/stm32h7x.cfg",
                "-c",
                "adapter speed 1000",
                "-c",
                "program build/Debug/MC02.elf verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": ["MC02 · 编译 Debug"],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
